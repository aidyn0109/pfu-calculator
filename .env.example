# --- База данных -------------------------------------------------------------
# Локально — SQLite. На Render задаётся автоматически (PostgreSQL).
DATABASE_URL=sqlite+aiosqlite:///./pfu.db

# --- Сервер ------------------------------------------------------------------
LOG_LEVEL=INFO
# PORT задаётся платформой (Render). Локально можно не указывать (по умолчанию 8000).

# --- Авторизация -------------------------------------------------------------
# Ключ подписи cookie-сессии. В продакшене ОБЯЗАТЕЛЬНО сгенерировать случайный.
SECRET_KEY=change-me-to-a-long-random-string

# Учётные записи (логин/пароль на роль).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
USER_USERNAME=user
USER_PASSWORD=user
